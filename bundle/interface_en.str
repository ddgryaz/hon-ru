// preorder_features.package



pofeatures_header							Оформите предзаказ на свою учетную запись HoN



pofeatures_title1							ПРЕДВАРИТЕЛЬНАЯ ПОКУПКА СЕГОДНЯ



pofeatures_title2							БЕЗ РЕГУЛЯРНЫХ ПЛАТЕЖЕЙ!



pofeatures_ppbenefit1						ЗАРЕЗЕРВИРУЙТЕ СВОЙ БЕТА-НИК



pofeatures_ppbenefit2						БЕТА-ПРИГЛАШЕНИЯ ДЛЯ ВАШИХ ДРУЗЕЙ



pofeatures_ppbenefit3						ВОЗМОЖНОСТЬ ПРОВОЦИРОВАТЬ В ИГРЕ



pofeatures_ppbenefit4						СПЕЦИАЛЬНЫЙ ВНУТРИГРОВОЙ ЗНАЧОК



pofeatures_ppbenefit5						УНИКАЛЬНЫЙ ЦВЕТ ИМЕНИ В ЧАТЕ



pofeatures_ppbenefit6						Купив аккаунт заранее, вы больше не увидите эту рекламу!



pofeatures_onetime							РАЗОВАЯ ПЛАТА!



pofeatures_oneusd							USD



pofeatures_feature_learnmore				Узнать больше



pofeatures_feature_gameplay					УЛУЧШЕНИЯ ГЕЙМПЛЕЯ



pofeatures_feature_engine					ПРЕИМУЩЕСТВА ДВИЖКА



pofeatures_feature_matchmaking				Система подбора игроков



pofeatures_feature_matchmakingtxt			Подбор равных соперников, играете ли вы один или с командой друзей.



pofeatures_feature_stattracking				Отслеживание статистики



pofeatures_feature_stattrackingtxt			Многие статистические данные отслеживаются игрой автоматически. Получите доступ к огромному количеству ценных данных онлайн или в игре.



pofeatures_feature_heroes					Разнообразные герои



pofeatures_feature_heroestxt				Играйте как с новыми героями HoN, так и со многими лучшими героями, с которыми вы уже знакомы.



pofeatures_feature_ladder					Рейтинговые таблицы



pofeatures_feature_laddertxt				Рейтинги игроков и кланов автоматически обновляются игрой. Посмотрите, какое место вы занимаете среди конкурентов.



pofeatures_feature_questladder				Рейтинг квестов



pofeatures_feature_questladdertxt			Сравните свои успехи в квестах с другими игроками.



pofeatures_feature_editor					Редактор пользовательских карт



pofeatures_feature_editortxt				Создавайте новые карты или даже новые игры с помощью встроенного редактора карт.



pofeatures_feature_reconnection				Переподключение к игре



pofeatures_feature_reconnectiontxt			Игры больше не портятся, если игрок отключается от сети. Отключившиеся игроки могут снова присоединиться к игре!



pofeatures_feature_noleaver					Защита от покинувших



pofeatures_feature_noleavertxt				Создавайте игры, в которые не пустят игроков, часто покидающих игры раньше времени.



pofeatures_feature_netcode					Сетевой код клиент-сервер



pofeatures_feature_netcodetxt				Никаких задержек у всех игроков, когда у одного игрока возникают проблемы с подключением!



pofeatures_feature_hotkeys					Переназначаемые горячие клавиши



pofeatures_feature_hotkeystxt				Назначайте собственные горячие клавиши практически для каждой команды в игре, что позволит вам максимально повысить эффективность.



pofeatures_feature_voip						Встроенный VOIP



pofeatures_feature_voiptxt					Нет необходимости во внешней программе голосового чата. Голосовой чат встроен в движок HoN.



pofeatures_pptoday							Чтобы сделать предварительную покупку, посетите наш сайт сегодня!



pofeatures_ulr								http://beta.heroesofnewerth.com/



pofeatures_closemsg							Чтобы оформить предварительную покупку учетной записи HoN, войдите на бета-сайт и нажмите кнопку покупки. Предварительная покупка вашей учетной записи осуществляется единоразово, и ваша учетная запись будет готова к игре, как только игра будет выпущена.







// game_replay_control.interface



game_replay_control_speed					Скорость



game_replay_control_viewing					^yПросмотр:^*



game_replay_control_view_as					Просмотреть как



game_replay_control_view_as_tip				Когда выбрано имя игрока, вы увидите повтор, как если бы вы были этим игроком. Если выбрать наблюдателя, повтор покажется в интерфейсе наблюдателя.



game_replay_control_title					Управление повтором



game_replay_control_fog						Туман войны



game_replay_control_fog_tip					Если этот параметр выбран, Туман войны будет отображаться так, как его видит выбранный игрок.



game_replay_control_lockcam					Заблокировать камеру



game_replay_control_lockcam2				Управление обзором



game_replay_control_lockcam_tip				Если этот параметр выбран, камера всегда будет следовать за выбранным игроком.



game_replay_control_lockcam_tip2			Установите этот флажок, чтобы следить за действиями камеры и мыши выбранного игрока или комментатора, если они доступны.



game_replay_control_enablebullet			Включить бегущие комментарии



game_replay_control_enablebullet_tip		Если этот флажок установлен, будут отображаться бегущие комментарии.



game_replay_tip_UnitFrames					Переключить видимость рамки юнита



game_replay_tip_PushBar						Переключить видимость панели пуша



game_replay_tip_Info						Переключить видимость вкладок с подробной информацией



game_replay_tip_Controls					Переключить видимость элементов управления воспроизведением



game_replay_optn_cam 						Камера



game_replay_optn_draw						Дальность прорисовки



game_replay_optn_cammode					Режим камеры



game_replay_spectator 						Наблюдатель







game_replay_spectator1						Наблюдатель







game_replay_control_title2					Управление потоковым вещанием



game_replay_control_voice_channel			Комментатор







