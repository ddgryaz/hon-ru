// Ability_Oogie2







Ability_Oogie2_name	Conflagrate







Ability_Oogie2_description										Переключение для быстрого расхода маны, дающего бафф к скорости и ауру самосожжения.







Ability_Oogie2_description2								







Ability_Oogie2_description_simple								Активируйте, чтобы включить или выключить. Пока способность включена, каждую секунду расходуется 4% вашей макс. маны.\n\nКаждую секунду наносит врагам рядом маг. урон в размере ^o{10,20,30,40}^* плюс ^o{2,3,4,5}%^* вашей макс. маны.\n\nПока включена, дает ^o{5,10,15,20}% доп. скор. движ.^*







Ability_Oogie2_effect_header								







Ability_Oogie2_effect_header2								







Ability_Oogie2_tooltip_flavor									Дайте мне взорва- себя!







Ability_Oogie2_IMPACT_effect									Активируйте, чтобы включить или выключить. Пока включено, тратит 4% макс. маны в сек. и каждую секунду наносит врагам вокруг маг. урон в размере {10,20,30,40} плюс {2,3,4,5}% вашей макс. маны. Пока активно, дает {5,10,15,20}% доп. скор. движ.















