State_Cthulhuphant_Ability4_Look_name 							Dreams of Madness







State_Cthulhuphant_Ability4_Look_FRAME_effect					Обезумеет и будет вынужден атаковать Ктулхуфанта при 0 зарядах















// State_Cthulhuphant_Ability4_Self







State_Cthulhuphant_Ability4_Self_name							Dreams of Madness







State_Cthulhuphant_Ability4_Self_description					Враги, смотрящие на вас слишком долго, обезумеют и атакуют вас















// Hero_Cthulhuphant







Hero_Cthulhuphant_name	Cthulhuphant







Hero_Cthulhuphant_description									Затерянный на глубинах темнейшего моря, мертвый бегемот грезил кошмаром непостижимого зла. Пропитанный первобытными энергиями земли, его сон обрел реальность как живое предзнаменование безумия, выбравшееся со дна океана на сушу.







Hero_Cthulhuphant_role											Cthulhuphant - крепкий боец с огромной живучестью в ранней игре. Когда приходит время командных боев, Dreams of Madness отгоняет врагов от союзников и заставляет их атаковать его прямо посреди схватки.























































// Ability_Dampeer1







Ability_Dampeer1_name	Terrorize







Ability_Dampeer1_description		Внушает ужас ближайшим врагам, нанося урон и заставляя их в страхе бежать.







Ability_Dampeer1_description_simple		Внушает ужас врагам вокруг, нанося ^o{75,125,175,225} маг. урона^* и накладывая ^oСтрах^* на ^o1 сек.^*\n\nУрон растёт на 40, а длительность Страха на 0,25 сек. за каждую ^rСущность^*, которой владеет Dampeer.







Ability_Dampeer1_description2									







Ability_Dampeer1_effect_header		Эффекты Страха







Ability_Dampeer1_effect_header2									







Ability_Dampeer1_tooltip_flavor		«БУ!»







Ability_Dampeer1_LEARN_effect									







Ability_Dampeer1_IMPACT_effect		Наносит ^o{75,125,175,225} маг. урона^* и накладывает ^oстрах^* на ^o1 сек.^*\n\nКаждая ^rEssence^* повышает урон на 40, а длительность страха на 0,25 сек.















// State_Dampeer_Ability1_Fear







State_Dampeer_Ability1_Fear_name								Terrorized







State_Dampeer_Ability1_Fear_description		Не бойся!







State_Dampeer_Ability1_Fear_FRAME_effect		Теряет контроль, бежит в страхе.















// Ability_Dampeer2







Ability_Dampeer2_name	Vampiric Flight







Ability_Dampeer2_description		Dampeer летит к выбранному врагу, раня и высасывая жизнь из всех, сквозь кого пролетает.







Ability_Dampeer2_description_simple		Взлетает к врагу. Каждый раз, пролетая сквозь врага, наносит ему ^o{80,110,140,170} маг. урона^* и ^oлечит вас на {16,22,28,34}^*.\n\nУрон растёт на 30, а лечение на 10 за каждую ^rСущность^*, которой вы владеете.








Ability_Dampeer2_description2									







Ability_Dampeer2_effect_header									







Ability_Dampeer2_effect_header2									







Ability_Dampeer2_tooltip_flavor		«Как летучая мышь из ада!»







Ability_Dampeer2_IMPACT_effect		Летит к цели, нанося ^o{80,110,140,170} маг. урона^* и ^oвосстанавливая {16,22,28,34}^* здоровья за каждого врага на пути.\n\nКаждая ^rEssence^* повышает урон на 30, а исцеление на 10.















// State_Dampeer_Ability2_Self







State_Dampeer_Ability2_Self_name								Vampiric Flight















// Ability_Dampeer3







Ability_Dampeer3_name											Bloodthirst







Ability_Dampeer3_description		Dampeer и союзники рядом получают вампиризм на атаках.







Ability_Dampeer3_description_simple		Даёт союзным юнитам ближнего боя рядом ^o{15,20,25,30}% вампиризма^*. Союзники дальнего боя получают ^o{2.5,5,7.5,10}% вампиризма^*.\n\nПереключить, чтобы действовало только на союзных героев рядом.\n\nДаёт 15 скор. атаки за каждую ^rСущность^*, которой вы владеете.







Ability_Dampeer3_description_simple:Dampeer_Aura_Heroes		Даёт союзным героям ближнего боя рядом ^o{15,20,25,30}% вампиризма^*. Герои дальнего боя получают ^o{2.5,5,7.5,10}% вампиризма^*.\n\nПереключить, чтобы действовало на всех союзных юнитов рядом.\n\nДаёт 15 скор. атаки за каждую ^rСущность^*, которой вы владеете.







Ability_Dampeer3_description2		Даёт союзникам ближнего боя {15,20,25,30}% вампиризма и дальнего боя {2.5,5,7.5,10}%.\n\nКаждая ^rСущность^* дает Dampeer 15 скор. атаки.







Ability_Dampeer3_description2:Dampeer_Aura_Heroes		Даёт героям ближнего боя {15,20,25,30}% вампиризма, а союзным героям дальнего боя {2.5,5,7.5,10}% вампиризма.\n\nКаждая ^rСущность^* даёт Dampeer 15 скор. атаки.







Ability_Dampeer3_IMPACT_effect		Переключает ауру на действие только по союзным героям.







Ability_Dampeer3_name:Dampeer_Aura_Heroes						Bloodthirst (Heroes)







Ability_Dampeer3_IMPACT_effect:Dampeer_Aura_Heroes		Переключает ауру на действие по всем союзным юнитам.







Ability_Dampeer3_effect_header									







Ability_Dampeer3_tooltip_flavor		«Кровавая Мэри для всех!»















// State_Dampeer_Ability3_Ally







State_Dampeer_Ability3_Ally_name								Bloodthirst







State_Dampeer_Ability3_Ally_description		Атаки имеют вампиризм.







State_Dampeer_Ability3_Ally_FRAME_effect		+{2.5,5,7.5,10}% вампиризма для дальнего боя















// Ability_Dampeer4







Ability_Dampeer4_name											Consume







Ability_Dampeer4_name:ult_boost									^gConsume*^*







Ability_Dampeer4_description		Dampeer вырывает зубами огромный кусок плоти врага, нанося урон и исцеляя себя на нанесенный урон.







Ability_Dampeer4_description2		^gЭта способность может быть усилена Посохом Мастера.^*\n\n^gЭффект посоха:^* лимит Сущностей увеличен с 3 до 6. После смерти вы теряете 1 Сущность, если у вас их 3 или меньше, или 2, если больше 3.







Ability_Dampeer4_description2:ult_boost		^gДлительность Страха ограничена 2 сек.^*







Ability_Dampeer4_description_simple		Вырывает кусок плоти врага, нанося ^o{200,300,400} маг. урона^* и ^oвосстанавливая нанесённый урон как здоровье^*. Наносит ^o+{30,50,70} урона^* за каждую ^rСущность^*, которой вы владеете, и мгновенно убивает крипов.\n\nДобавляет ^rСущность^* при каждом использовании ^oConsume^*, или 3 ^rСущности^*, если добивает вражеского героя. Одновременно можно держать до ^c3 Сущностей^*. При смерти теряется 1 ^rСущность^*.\n\n^gПосох Мастера^* поднимает предел Сущностей с 3 до 6. Если при смерти у Dampeer больше 3 Сущностей, он теряет 2 вместо 1.







Ability_Dampeer4_description_simple:ult_boost		Вырывает кусок плоти врага, нанося ^o{200,300,400} маг. урона^* и ^oвосстанавливая нанесённый урон как здоровье^*. Наносит ^o+{30,50,70} урона^* за каждую ^rСущность^*, которой владеет Dampeer, и мгновенно убивает крипов.\n\nДобавляет ^rСущность^* при каждом использовании Consume, или 3 ^rСущности^*, если Consume добивает вражеского героя. Одновременно можно держать до ^g6 Сущностей^*, и ^gпри смерти теряется 1 заряд, если Сущностей 3 или меньше, иначе теряется 2^*.







Ability_Dampeer4_effect_header									







Ability_Dampeer4_effect_header2									







Ability_Dampeer4_tooltip_flavor		«Кусать или не кусать? Вот в чём вопрос.»







Ability_Dampeer4_IMPACT_effect		Откусывает кусок плоти врага, нанося ему ^o{200,300,400} маг. урона^* и исцеляя вас на столько же. За каждую вашу ^rEssence^* наносит ^oна {30,50,70} урона больше^*, крипов убивает мгновенно.\n\nКаждое применение ^oConsume^* дает ^rEssence^*, а убийство вражеского героя - 3 ^rEssence^*. Можно держать до ^c3 Essence^*. При смерти теряется 1 ^rEssence^*.\n\n^gПосох Мастера^* повышает предел Essence с 3 до 6. Если при смерти у Dampeer больше 3 Essence, он теряет 2 вместо 1.







Ability_Dampeer4_IMPACT_effect:ult_boost		Откусывает кусок плоти врага, нанося ему ^o{200,300,400} маг. урона^* и исцеляя вас на столько же. За каждую ^rEssence^* Dampeer наносит ^oна {30,50,70} урона больше^*, крипов убивает мгновенно.\n\nКаждое применение Consume дает ^rEssence^*, а если Consume убивает вражеского героя - 3 ^rEssence^*. Можно держать до ^g6 Essence^*, а при смерти ^gтеряется 1, если их 3 или меньше, иначе 2^*.















// State_Dampeer_Ability4_Hero







State_Dampeer_Ability4_Hero_name								Consume







State_Dampeer_Ability4_Hero_FRAME_effect		Смерть усилит Дампера.















// Hero_Dampeer







Hero_Dampeer_name	Dampeer







Hero_Dampeer_description		Говорят, что в самые темные дни войны, когда по земле шел голод, некоторые люди стали есть плоть мертвых, а затем и живых. Быть может, так и появился Dampeer - чудовище, питающееся жизненной силой врагов и несущее ужас на рваных крыльях. Штаны - единственное, что осталось в нем от человека.







Hero_Dampeer_role		У Dampeer очень высокая живучесть и урон от заклинаний, что выделяет его среди керри ближнего боя, зависящих от предметов. Но его успех сильно зависит от зарядов Сущности, которые он получает через Consume.







































// Ability_Deadlift1







Ability_Deadlift1_name	Unholy Strength







Ability_Deadlift1_name:ult_boost								^gUnholy Power*^*







Ability_Deadlift1_description									Наносит урон врагам в области и крадет силу у вражеских героев.







Ability_Deadlift1_description2									^gЭта способность может быть усилена Посохом Мастера.^*\n\n^gЭффект посоха:^* уменьшает перезарядку на 1,5 сек. и увеличивает перехват силы до 8.







Ability_Deadlift1_description2:ult_boost 	^gЭта способность может быть усилена Посохом Мастера.^*\n\n^gЭффект посоха:^* уменьшает перезарядку на 1,5 сек. и увеличивает перехват силы до 8.







Ability_Deadlift1_description_simple							Выберите область, чтобы нанести врагам в радиусе ^o{25,50,75,100} маг. урона^* (x2 по юнитам, не являющимся героями), похищая у задетых вражеских героев ^o4 силы^* на 30 сек. Максимум 80 доп. силы.\n\n^gПосох Мастера^* сокращает перезарядку на 1,5 сек. и повышает кражу силы до 8.







Ability_Deadlift1_description_simple:ult_boost					Примените на область, чтобы нанести ^o{25,50,75,100} маг. урона^* (x2 для юнитов, не являющихся героями) врагам в радиусе действия, похищая ^g8 силы^* у пойманных вражеских героев на 30 сек. Максимум 80 бонусной силы.







Ability_Deadlift1_IMPACT_effect									Выберите область, чтобы нанести врагам в радиусе ^o{25,50,75,100} маг. урона^* (x2 юнитам, кроме героев) и на 30 сек. украсть у задетых вражеских героев по ^o4 силы^*. Максимум 80 доп. силы.







Ability_Deadlift1_IMPACT_effect:ult_boost						Выберите область, чтобы нанести врагам в радиусе ^o{25,50,75,100} маг. урона^* (x2 юнитам, кроме героев) и на 30 сек. украсть у задетых вражеских героев по ^g8 силы^*. Максимум 80 доп. силы.







Ability_Deadlift1_tooltip_flavor								Я просто заберу это, раз ты не пользуешься, спасибо.















// State_Deadlift_Ability1_Self







State_Deadlift_Ability1_Self_name								Unholy Strength















// State_Deadlift_Ability1_Enemy







State_Deadlift_Ability1_Enemy_name								Unholy Strength















// Ability_Deadlift2







Ability_Deadlift2_name	Onslaught







Ability_Deadlift2_description									Бежит к цели с повышенной скор. движ. и скор. атаки, заставляя союзных крипов рядом атаковать ее.







Ability_Deadlift2_description_simple							Выберите вражеского юнита или строение, чтобы подбежать к нему и наложить ^oзамедление скор. движ. на 50%^* на 2 сек. Вы призываете на помощь ^o{2,3,4,5} мертвецов^* и заставляете всех союзных юнитов рядом, не являющихся героями, сделать то же.\n\nЭти союзники получают ^o{20,40,60,80} скор. атаки^* и ^oатакуют цель^* 6 сек., нанося повышенный урон по строениям и пониженный по остальным юнитам.







Ability_Deadlift2_IMPACT_effect									Выберите вражеского юнита или строение, чтобы бежать к нему со скор. движ. 550 и проходом сквозь юнитов. Цель получает замедление скор. движ. на 50%, а все союзные юниты рядом, кроме героев, тоже бросаются на нее.\n\nПри применении также призывает {2,3,4,5} Undead на помощь. У Undead 30 урона от атаки и перезарядка атаки 1,6 сек.\n\nЗатронутые союзные юниты получают {20,40,60,80} скор. атаки и 6 сек. обязаны атаковать цель. В это время они наносят 150% урона строениям и 50% урона остальным юнитам.







Ability_Deadlift2_tooltip_flavor								Ты потерял рассудок?















// State_Deadlift_Ability2







State_Deadlift_Ability2_name									Onslaught







State_Deadlift_Ability2_description								Вынужден атаковать цель















// State_Deadlift_Ability2_Attack







State_Deadlift_Ability2_Attack_name								Onslaught















// State_Deadlift_Ability2_Speed







State_Deadlift_Ability2_Speed_name								Onslaught















