// Ability_Moraxus2







Ability_Moraxus2_name	Arcane Shield







Ability_Moraxus2_description									Moraxus получает доп. броню и при точном расчете может поглощать энергию вражеских заклинаний.







Ability_Moraxus2_description2									







Ability_Moraxus2_description_simple								Дает ^o{0,2,4,6,8} брони^*.\n\n^oПоглощает^* способность или снаряд способности, направленные в вас, в течение ^o2,5 сек.^* Если что-то поглощено, на 7 сек. вы получаете ^o+{0,15,20,25,30}% ко всему урону^*, ^o{0,200} скор. движ.^* и ^o{0,40,60,80,100}% сопротивления замедлению^*.







Ability_Moraxus2_effect_header									Эффект магического всплеска







Ability_Moraxus2_effect_header2									







Ability_Moraxus2_tooltip_flavor									Покоооормииии меняяяяя...







Ability_Moraxus2_FRAME_effect									







Ability_Moraxus2_IMPACT_effect									В течение ^o2,5 сек.^* Moraxus поглощает следующую направленную в него способность или снаряд способности. Если что-то поглощено, Moraxus получает ^oArcane Surge^* на ^o7 сек.^*















// State_Moraxus_Ability2







