// Ability_Solstice2







Ability_Solstice2_name											Shining Rays







Ability_Solstice2_name:Day_Solstice								Illuminate







Ability_Solstice2_name:Night_Solstice							Luminescence







Ability_Solstice2_description									Solstice взывает к звездам и раскрывает область, раня врагов или усиливая себя.







Ability_Solstice2_description:Day_Solstice						Солнцесто призывает солнечные лучи, чтобы сжечь врагов.







Ability_Solstice2_description:Night_Solstice					Солнцесто призывает лунный свет, усиливая себя и обнаруживая врагов.







Ability_Solstice2_description2									







Ability_Solstice2_description_simple							^rДнем^*\nПризывает солнечные лучи: вы получаете 700 беспрепятственного обзора, а враги рядом ^o8 сек.^* горят, получая ^o{15,30,45,60} маг. урона в сек.^*\n^bНочью^*\nПризывает лунный свет, который раскрывает область и на 8 сек. дает вам ^o{15,30,45,60} урона атаки и скор. движ.^*







Ability_Solstice2_description_simple:Day_Solstice				^rДневное время^*\nВызовите солнечные лучи, которые дают вам 700 ясности и сжигают ближайших врагов в течение ^o8 сек.^*, нанося ^o{15,30,45,60} маг. урона в сек.^*







Ability_Solstice2_description_simple:Night_Solstice				^bНочное время^*\nВызовите лунный свет, чтобы осветить область и предоставить вам ^o{15,30,45,60} урон от атаки и скор. движ.^* на 8 сек.







Ability_Solstice2_effect_header:Day_Solstice					Эффект(ы) озарения







Ability_Solstice2_effect_header:Night_Solstice					Эффект(ы) свечения







Ability_Solstice2_effect_header2								







Ability_Solstice2_IMPACT_effect:Day_Solstice					^rДнем^*\nНакладывает на вас ^oIlluminate^* на ^o8 сек.^*\n^rДнем^*







Ability_Solstice2_IMPACT_effect:Night_Solstice					^bНочью^*\nВыберите область, чтобы 8 сек. видеть в ней врагов. Накладывает на вас ^oLuminescence^* на 8 сек.\n\n-Враги не знают, что их видно.\n^bНочью^*







Ability_Solstice2_tooltip_flavor								Подкрадывайся!















